# Copy this file to backend/.env and adjust. Real environment variables
# override the values here. Never commit your .env (it is in .gitignore).

# Required. Postgres with the pgvector extension (see README.md).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://knowledgevault:knowledgevault@localhost:5432/knowledgevault

# Required. Signs the sign-in tokens (KV-42): at least 32 characters, kept
# secret. Changing it signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (or `openssl rand -hex 32` where openssl is installed)
SECRET_KEY=

# How long a sign-in lasts, in hours (default 24)
# ACCESS_TOKEN_HOURS=24

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Default: the local Vite dev server. Add the deployed frontend's URL when you
# deploy, e.g. http://localhost:5173,https://app.example.com
# CORS_ORIGINS=http://localhost:5173

# Largest upload accepted, in MB (default 10)
# MAX_UPLOAD_MB=10

# Tests only (see README.md, "Running the tests"):
# TEST_DATABASE_URL=postgresql+psycopg2://knowledgevault:knowledgevault@localhost:5432/knowledgevault_test
# KV_FAKE_EMBEDDINGS=1
# BCRYPT_ROUNDS=4            # faster password hashing; tests set this for you
