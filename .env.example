# Settings for docker compose. Copy to .env (same folder as the compose files).
# .env is in .gitignore: never commit it.

# --- Local development (docker-compose.yml) ---------------------------------
# All optional.
# BACKEND_PORT=8000
# DB_PORT=5433
# CORS_ORIGINS=http://localhost:5173
# MAX_UPLOAD_MB=10

# --- Server (docker-compose.prod.yml, see deploy/README.md) -----------------
# All three are required there.

# Public name of the server. Without a domain, use the server's IP with dashes
# plus .sslip.io, e.g. IP 3.91.12.45 -> 3-91-12-45.sslip.io
API_HOST=

# Database password. Use letters and numbers only (it goes into a URL):
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Include http://localhost:5173 to use the deployed API from a local frontend.
CORS_ORIGINS=http://localhost:5173
