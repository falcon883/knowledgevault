# Settings for docker compose. Copy to .env (same folder as the compose files).
# .env is in .gitignore: never commit it.

# --- Local development (docker-compose.yml) ---------------------------------
# All optional.
# BACKEND_PORT=8000
# DB_PORT=5433
# CORS_ORIGINS=http://localhost:5173
# MAX_UPLOAD_MB=10
# SECRET_KEY=            # signs sign-in tokens; a fixed development key is used if unset

# --- Server (docker-compose.prod.yml, see deploy/README.md) -----------------
# All of these are required there.

# Public name of the server. Without a domain, use the server's IP with dashes
# plus .sslip.io, e.g. IP 3.91.12.45 -> 3-91-12-45.sslip.io
API_HOST=

# Database password. Use letters and numbers only (it goes into a URL):
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# Signs the sign-in tokens (KV-42). At least 32 characters; keep it secret, and
# note that changing it signs everyone out:
#   openssl rand -hex 32
SECRET_KEY=

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Include http://localhost:5173 to use the deployed API from a local frontend.
CORS_ORIGINS=http://localhost:5173

# Password reset (KV-53). Optional, but without SMTP_HOST no email is sent: the
# reset link is only written to the backend log.
# Where the app is served; links in reset emails point here. Defaults to the
# first CORS_ORIGINS entry, so set it if that is not the deployed frontend.
FRONTEND_URL=
# An outgoing mail server. For Gmail: smtp.gmail.com, your address, and an app
# password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Sender shown on the email. Defaults to SMTP_USER.
MAIL_FROM=

# Limits on failed sign-ins (KV-54). Optional; these are the defaults. After
# this many wrong passwords for one email (or from one address) within the
# window, sign-in is refused until the oldest failure is a window old.
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=10
